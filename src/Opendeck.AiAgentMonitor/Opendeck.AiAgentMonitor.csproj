<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Opendeck.AiAgentMonitor</RootNamespace>
    <AssemblyName>opendeck-aiagentmonitor</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- scripts/build.sh publishes self-contained single-file binaries per RID; keeping those flags out of the
         project file lets the test project reference this one normally -->
    <Version>0.2.3</Version>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Opendeck.AiAgentMonitor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\plugin\com.josbol.aiagentmonitor.sdPlugin\assets\fonts\*.ttf" Link="fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
